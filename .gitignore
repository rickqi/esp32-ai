# python
__pycache__/
.venv/
*.pyc

# data + tokenizers (regenerate with data/prepare.py)
data/*.bin
data/*.txt
data/*.json

# training outputs
runs/

# generated firmware artifacts (regenerate with src/export.py, src/gen_assets.py)
firmware/model/model.bin
firmware/model/golden.npz
firmware/model/golden.txt
firmware/esp32_llm/vocab.h

# chinese pipeline generated data + runs (regenerate with chinese/*.py)
data_chinese/*.bin
data_chinese/*.txt
# tokenizer.json is tracked — required to regenerate firmware vocab.h on any machine
!data_chinese/tokenizer.json
data_chinese/sft/
runs_chinese/
firmware/model_chinese/
firmware/esp32_llm_zh/vocab.h
chinese/__pycache__/

# chinese_v2 environment (independent, regenerable)
data_v2/
runs_v2/
firmware/model_v2/
firmware/esp32_llm_zh_v2/vocab.h
chinese_v2/__pycache__/

# raw video / recordings (demo footage — keep out of the repo)
video/
videos/
*.mp4
*.mov
*.MOV
*.MP4

# opencode agent working state
.omo/

# screenshot output (generated by tools/capture_screenshot.py)
output/
